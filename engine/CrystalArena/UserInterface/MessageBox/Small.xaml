<UserControl x:Class="CrystalArena.UserInterface.MessageBox.Small" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:cl="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro" xmlns:CrystalArena="clr-namespace:CrystalArena.UserInterface">
	<i:Interaction.Triggers>
	</i:Interaction.Triggers>

	<Border>
		<Border.Resources>
			<Style Selector="TextBlock"  />
			<Style Selector="Button"  />
		</Border.Resources>
		<StackPanel Orientation="Horizontal">
			<Image Margin="0,0,10,0"  />
			<TextBlock Foreground="#FFD700" Text="{Binding Message}" />
			<StackPanel >
				<Button x:Name="Ok"  Content="Ok" />
				<Button x:Name="Yes" />
					<StackPanel Orientation="Horizontal">
						<TextBlock Foreground="#FFD700">Yes.</TextBlock>
						<TextBlock Margin="7,0,0,0">(Press Enter.)</TextBlock>
					</StackPanel>
				
				<Button x:Name="No" >
					<StackPanel Orientation="Horizontal">
						<TextBlock Foreground="#FFD700">No.</TextBlock>
						<TextBlock Margin="7,0,0,0">(Press Spacebar.)</TextBlock>
					</StackPanel>
				</Button>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>