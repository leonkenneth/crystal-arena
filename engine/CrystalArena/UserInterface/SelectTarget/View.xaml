<UserControl
  x:Class="CrystalArena.UserInterface.SelectTarget.View"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
  xmlns:cl="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro"
  xmlns:CrystalArena="clr-namespace:CrystalArena.UserInterface"
>
  <i:Interaction.Triggers></i:Interaction.Triggers>

  <Border>
    <Border.Resources>
      <Style Selector="TextBlock" />
    </Border.Resources>
    <StackPanel Orientation="Horizontal">
      <Image Margin="0,0,10,0" Source="{StaticResource DialogIcon}" />
      <TextBlock Foreground="#FFD700" Text="{Binding Text}" />
      <TextBlock
        Margin="10,0,0,0"
        Text="{Binding Instructions}"
        IsVisible="{Binding Instructions, Converter={x:Static CrystalArena:Converters.NullToCollapsed}}"
      />
    </StackPanel>
  </Border>
</UserControl>
