<UserControl
  x:Class="CrystalArena.UserInterface.SelectableCard.View"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
  xmlns:cal="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro"
  xmlns:UserInterface="clr-namespace:CrystalArena.UserInterface"
>
  <Border
    Margin="0,-272,0,0"
    IsVisible="{Binding IsVisibleInUi, Converter={x:Static UserInterface:Converters.BooleanToVisibility}}"
  >
    <ContentControl>
      <i:Interaction.Triggers></i:Interaction.Triggers>

      <Grid>
        <ContentControl Content="{Binding }" />
        <Border
          Background="{StaticResource Selected}"
          IsVisible="{Binding IsSelected, Converter={x:Static UserInterface:Converters.BooleanToVisibility}}"
        />
      </Grid>
    </ContentControl>
  </Border>
</UserControl>
