<UserControl
  x:Class="CrystalArena.UserInterface.SelectXCost.View"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
  xmlns:cl="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro"
  xmlns:CrystalArena="clr-namespace:CrystalArena.UserInterface"
>
  <i:Interaction.Triggers></i:Interaction.Triggers>

  <Border>
    <Border.Resources>
      <Style Selector="TextBlock" />
    </Border.Resources>
    <StackPanel Orientation="Horizontal">
      <Image Margin="0,0,10,0" Source="{StaticResource DialogIcon}" />
      <TextBlock Foreground="#FFD700" Text="Please choose X: " Margin="0,0,2,0" />
      <ComboBox
        FontSize="16"
        VerticalAlignment="Center"
        ItemsSource="{Binding ValidXChoices}"
        SelectedItem="{Binding ChosenX}"
      />
      <TextBlock
        Margin="10,0,0,0"
        Text="(Press Escape, to cancel)"
        IsVisible="{Binding CanCancel, Converter={x:Static CrystalArena:Converters.BooleanToVisibility}}"
      />
    </StackPanel>
  </Border>
</UserControl>
