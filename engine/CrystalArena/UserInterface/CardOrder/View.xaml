<UserControl x:Class="CrystalArena.UserInterface.CardOrder.View"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:cal="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro"
             xmlns:Gameplay="clr-namespace:CrystalArena">
    <Border>
        <Border.Resources>
            <Style  Selector="{x:Type ScrollBar}" />
        </Border.Resources>
        <Grid Width="680">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource BarBackground}">
                <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                    <Image Margin="0,0,10,0" Source="{StaticResource DialogIcon}" />
                    <TextBlock  Text="{Binding Title}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">

                <Border Grid.Row="0" BorderBrush="#000" BorderThickness="0,1,0,0" Background="#222" Height="245">
                    <ItemsControl ItemsSource="{Binding Objects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="10,20,10,20" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Grid Margin="10,0,0,0">
                                    <Interactivity:Interaction.Triggers>
                                   
                                    </Interactivity:Interaction.Triggers>

                                    <ContentControl >
                                        <ContentControl Content="{Binding Object}">
                                        </ContentControl>
                                    </ContentControl>

                                    <TextBlock  HorizontalAlignment="Center" FontSize="80" FontWeight="Bold" Text="{Binding Order}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </ScrollViewer>
            <Border Grid.Row="2" Background="#1a1a1a">
                <StackPanel HorizontalAlignment="Right" Margin="0,0,5,0" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style  Selector="Button">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Foreground" Value="#fff" />
                            <Setter Property="Margin" Value="0,0,20,0" />
                        </Style>
                    </StackPanel.Resources>

                    <Button x:Name="Accept" Content="Accept" />
                    <Button x:Name="Clear" Content="Clear" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
