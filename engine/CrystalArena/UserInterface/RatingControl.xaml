<Grid x:Class="CrystalArena.UserInterface.RatingControl" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:CrystalArena="clr-namespace:CrystalArena.UserInterface"  Cursor="Hand">
	<Grid.Resources>
		<Style Selector="{x:Type ToggleButton}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ToggleButton}">
						<Image Name="star" Source="{CrystalArena:Media 'empty-star.png'}" />
			
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="Width" Value="50" />						
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		</Style>
	</Grid.Resources>
    
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>        
    </Grid.ColumnDefinitions>
  <!--
	<ToggleButton Grid.Column="0" Tag="1" Click="RatingButtonClickEventHandler" />
    <ToggleButton Grid.Column="1" Tag="2" Click="RatingButtonClickEventHandler" />
    <ToggleButton Grid.Column="2" Tag="3" Click="RatingButtonClickEventHandler" />
    <ToggleButton Grid.Column="3" Tag="4" Click="RatingButtonClickEventHandler" />
    <ToggleButton Grid.Column="4" Tag="5" Click="RatingButtonClickEventHandler" />
    -->
</Grid>